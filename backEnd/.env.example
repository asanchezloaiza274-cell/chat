# Django
# Generate a real one for staging/production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-local-development-key-change-this
DEBUG=True

# Database
# Leave unset locally to use SQLite (db.sqlite3).
# In production, Render/Supabase/etc. provide this automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Realtime (Django Channels)
# Leave unset locally: falls back to an in-memory channel layer (single process only).
# Set this in production if you run more than one worker process, so realtime
# events (messages, typing, presence) reach users connected to a different worker.
# REDIS_URL=redis://localhost:6379/0
